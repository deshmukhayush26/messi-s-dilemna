# ==============================================================================
# CCG × OpenAI: Inter Miami's Messi Dilemma — Environment Configuration Example
# Copy this file to .env and supply your credentials. Never commit real keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Vercel or Local Vite)
# ------------------------------------------------------------------------------
# In production on Vercel, set this to your deployed Render API backend origin.
# Example: https://ccg-case-backend.onrender.com
# When left empty locally, Vite proxies requests via relative /api.
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. Node / Express API Backend Service (Render or Local)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Allowed origins for CORS (comma-separated or single origin)
# Example production: https://ccg-competition.vercel.app
CLIENT_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Secret key required to access /admin and execute organizer controls
ORGANIZER_SECRET_KEY=ccg-admin-2026

# Persistent storage directory for SQLite database & uploaded deck files
# In local development: ./data
# In production on Render with persistent disk: /data
DATA_DIR=./data

# PostgreSQL Connection String (Render Postgres, Neon, or Supabase)
# MANDATORY in production (NODE_ENV=production): Express fails immediately on startup if missing.
# In local development (NODE_ENV=development), if omitted, falls back to local isolated SQLite.
DATABASE_URL=postgresql://ccg_admin:password@localhost:5432/ccg_competition

# ------------------------------------------------------------------------------
# 3. Python Webmail OTP Authentication Microservice
# ------------------------------------------------------------------------------
# Private service address called by the Node backend (never exposed to frontend)
# Local: http://127.0.0.1:5001
# Render: http://ccg-webmail-otp-service:5001 or internal Render hostname
OTP_SERVICE_URL=http://127.0.0.1:5001
OTP_PORT=5001

# Shared secret between Node backend and Python OTP microservice
OTP_SERVICE_SHARED_SECRET=replace_with_a_long_random_hex_string

# Secret for signing token payloads in Python
FLASK_SECRET=replace_with_a_secure_random_hex_key_here
OTP_EXPIRY_SEC=600

# Institutional SMTP Settings (e.g., IIT Bombay Webmail Relay)
SMTP_HOST=smtp-auth.iitb.ac.in
SMTP_PORT=587
SMTP_USER=your_ldap_or_sending_id
SMTP_PASS=your_ldap_or_app_password

# Development Toggle (STRICTLY FORBIDDEN IN PRODUCTION: keep false)
DEV_BYPASS_OTP=false

# ------------------------------------------------------------------------------
# 4. AI Case Judge Pipeline Settings (OpenAI & Featherless AI)
# ------------------------------------------------------------------------------
# Master switch: real judge is opt-in (keeps mock/placeholder active until enabled)
AI_JUDGE_ENABLED=false

# Configurable provider: "openai" or "featherless"
AI_PROVIDER=openai

# OpenAI Provider Credentials & Model Identifier
OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o

# Featherless AI Provider Credentials & Model Identifier (OpenAI-compatible)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_JUDGE_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct

# Execution Controls & Safety Limits
AI_JUDGE_MAX_CONCURRENCY=2
AI_JUDGE_MAX_RETRIES=3
AI_JUDGE_MAX_OUTPUT_TOKENS=2500
AI_JUDGE_BUDGET_USD=50.0
AI_JUDGE_RUBRIC_VERSION=v1

# ------------------------------------------------------------------------------
# 5. Object Storage Configuration (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
# When omitted, local persistent volume disk (DATA_DIR/uploads/) is used safely.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
