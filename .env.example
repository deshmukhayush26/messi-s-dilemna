# ==============================================================================
# CCG × OpenAI: Inter Miami's Messi Dilemma — Environment Configuration Example
# Copy this file to .env and supply your credentials. Never commit real keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Vercel or Local Vite)
# ------------------------------------------------------------------------------
# In production on Vercel, set this to your deployed Render API backend origin.
# Example: https://ccg-case-backend.onrender.com
# When left empty, relative /api requests route through Vercel proxy or Vite dev proxy.
VITE_API_URL=https://ccg-case-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. Node / Express API Backend Service (Render or Local)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Allowed origins for CORS (comma-separated or single origin)
CLIENT_ORIGIN=https://messi-s-dilemna.vercel.app
FRONTEND_URL=https://messi-s-dilemna.vercel.app

# Secret key required to access /admin and execute organizer controls
ORGANIZER_SECRET_KEY=ccg-admin-2026

# Local storage directory for development SQLite & local uploaded deck files
DATA_DIR=./data

# PostgreSQL Connection String (Render Postgres, Neon, or Supabase)
# MANDATORY in production (NODE_ENV=production): Express fails immediately on startup if missing.
# In local development (NODE_ENV=development), if omitted, falls back to local isolated SQLite.
DATABASE_URL=postgresql://ccg_admin:password@localhost:5432/ccg_competition

# ------------------------------------------------------------------------------
# 3. AI Case Judge Pipeline Settings (Featherless AI & OpenAI)
# ------------------------------------------------------------------------------
# Real AI Judge is enabled by default in production
AI_JUDGE_ENABLED=true

# Preferred provider: "featherless" (default) or "openai"
AI_PROVIDER=featherless

# Featherless AI Provider Credentials & Model Identifier (OpenAI-compatible)
# Sign up at https://featherless.ai to retrieve your API key
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# OpenAI Provider Credentials & Model Identifier (Optional fallback)
OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o

# Execution Controls & Safety Limits
AI_JUDGE_MAX_CONCURRENCY=2
AI_JUDGE_MAX_RETRIES=3
AI_JUDGE_MAX_OUTPUT_TOKENS=2500
AI_JUDGE_BUDGET_USD=50.0
AI_JUDGE_RUBRIC_VERSION=v1

# ------------------------------------------------------------------------------
# 4. Object Storage Configuration (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
# When omitted, local ephemeral or container storage is used.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
