{
  "name": "handson",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "dev:full": "concurrently -k -p \"[{name}]\" -n \"OTP,SERVER,CLIENT\" -c \"yellow,cyan,magenta\" \"npm run otp\" \"npm run server\" \"npm run client\"",
    "otp": "python otp_server.py",
    "test": "tsx scripts/test_workflow.ts",
    "client": "vite",
    "server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@types/pdf-parse": "^1.1.5",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "multer": "^2.4.0",
    "openai": "^7.32.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
